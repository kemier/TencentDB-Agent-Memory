# ============================================================
# TDAI Gateway — local native run config (no Docker)
# COPY THIS FILE to run/tdai-gateway.yaml and edit the `llm` block
# to point at YOUR LLM endpoint before starting memory-core:
#
#   cp run/tdai-gateway.yaml.example run/tdai-gateway.yaml
#
# The placeholders below are generic OpenAI-compatible defaults —
# replace baseUrl / apiKey / model with your own provider.
# ============================================================
deployMode: standalone
stateBackend: local

server:
  port: 8420
  host: "127.0.0.1"
  corsOrigins: ["*"]

data:
  baseDir: "./run/data/memory-core"

# ── LLM: your OpenAI-compatible endpoint ──
llm:
  baseUrl: "http://127.0.0.1:8000/v1"   # <- your LLM endpoint
  apiKey: "your-api-key"                # <- your key (or "" if auth disabled)
  model: "gpt-4o-mini"                  # <- your model id
  maxTokens: 32000
  timeoutMs: 300000
  provider: openai

memory:
  promptMode: chat
  capture:
    enabled: true
  extraction:
    enabled: true
    enableDedup: true
    maxMemoriesPerSession: 20
  persona:
    triggerEveryN: 50
    maxScenes: 15
  pipeline:
    everyNConversations: 5
    enableWarmup: true
    l1IdleTimeoutSeconds: 600
    l2DelayAfterL1Seconds: 90
    l2MinIntervalSeconds: 900
    l2MaxIntervalSeconds: 3600
  recall:
    enabled: true
    maxResults: 5
    scoreThreshold: 0.3
    strategy: hybrid
    timeoutMs: 5000
  storeBackend: sqlite
  embedding:
    provider: none
  bm25:
    enabled: true
    language: en

# ── Skill module ──
skill:
  enabled: true
  routing:
    mode: bm25
    searchTopK: 20
  extraction:
    enabled: true
    maxIterations: 16
    queue:
      backend: local
      keyPrefix: tdai
      resultTtlSeconds: 86400
      lockTtlMs: 600000
      maxRetries: 2
      retryBackoffsMs: [5000, 15000]
  resources:
    maxResourceSizeBytes: 5000000
